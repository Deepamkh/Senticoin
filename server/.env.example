# Everything below is FREE. The app runs with no keys at all.

# ---- Server ----
PORT=4000
# How many coins (by market cap) to rank on the dashboard (5-100)
TOP_N=50

# Force synthetic demo data (no network needed). You can also run `npm run demo`.
MOCK_DATA=false

# ---- Market data: CoinGecko ----
# Optional FREE "Demo" key (10,000 calls/month, no credit card) → more reliable than keyless access.
# Sign up on the Demo plan at https://www.coingecko.com/en/api/pricing, then create a key in the Developer Dashboard.
COINGECKO_API_KEY=

# ---- PAID, optional: Claude AI sentiment ----
# Leave blank to stay 100% free (the built-in crypto lexicon model is used instead).
# Anthropic API usage is billed per token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
