# ---- Server ----
PORT=4000
# How many coins (by market cap) to rank on the dashboard (5-100)
TOP_N=50

# Force synthetic demo data (no network needed). You can also run `npm run demo`.
MOCK_DATA=false

# ---- Market data: CoinGecko ----
# Works without a key (public rate limits ~5-30 req/min). A free "Demo" key raises limits:
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Set to true only if you have a paid Pro key
COINGECKO_PRO=false

# ---- AI sentiment (optional but recommended) ----
# When set, headlines & social posts are scored by Claude and each coin gets an AI analyst summary.
# Without it, a crypto-tuned lexicon model is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Extra news source (optional) ----
# CryptoPanic aggregates crypto news with community bullish/bearish votes: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE=https://cryptopanic.com/api/developer/v2
